// Tells Cloudflare how to build the website and where the finished pages are.
{
  "name": "blue-and-green-world",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "blueandgreenworld.com", "custom_domain": true },
    { "pattern": "www.blueandgreenworld.com", "custom_domain": true }
  ],
  "build": {
    "command": "node build.js"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
